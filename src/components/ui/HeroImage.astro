---
/**
 * HeroImage Component
 * Компонент для отображения hero-изображений с оптимизацией через astro:assets
 * 
 * ВАЖНО: Все изображения должны находиться в src/assets/images/
 * 
 * Использование:
 * 1. Локальные изображения (рекомендуется):
 *    import heroImg from '@/assets/images/hero/hero-bg.jpg';
 *    <HeroImage src={heroImg} alt="..." />
 *
 * 2. Для Content Collections - используй путь из frontmatter:
 *    <HeroImage src={post.data.heroImage} alt={post.data.title} />
 */

import { Image, type ImageMetadata } from 'astro:assets';

interface Props {
  /** Локальное изображение из src/assets/images/ (ImageMetadata) */
  src?: ImageMetadata;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
}

const { 
  src, 
  alt, 
  width = 1200, 
  height = 600,
  class: className = '' 
} = Astro.props;

// Если изображение не указано, не рендерим компонент
if (!src) {
  return null;
}

// Компонент <Image /> из astro:assets оптимизирует локальные изображения
// Все изображения должны находиться в src/assets/images/
---
{src && (
  <div class={`mb-6 ${className}`}>
    <Image 
      src={src}
      alt={alt}
      width={width}
      height={height}
      class="w-full h-auto rounded-lg object-cover"
    />
  </div>
)}
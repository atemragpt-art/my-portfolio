---
interface Props {
  class?: string;
  container?: boolean;
}

const { class: className = '', container = true } = Astro.props;
---

<section class={`py-12 md:py-16 lg:py-20 ${className}`}>
  {container ? (
    <div class="container mx-auto px-4">
      <slot />
    </div>
  ) : (
    <slot />
  )}
</section>

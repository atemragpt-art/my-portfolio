---
/**
 * Language Switcher Component
 * Обновлен для соответствия дизайн-системе из Figma
 */
import { languages, type Lang } from '@/i18n/ui';
import { getLangFromUrl, getLocalizedPath } from '@/i18n/utils';
import { Spacing, Tokens } from '@/config/tokens';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const currentLang = getLangFromUrl(Astro.url);
const currentPath = Astro.url.pathname;
---

<style>
  .language-switcher {
    position: relative;
  }

  .language-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-8);
    min-width: 70px;
    height: 45px;
    padding: 0 var(--spacing-12);
    border: 1px solid var(--text-primary);
    border-radius: var(--spacing-radius-md);
    background-color: transparent;
    color: var(--text-primary);
    font-size: 14px;
    font-weight: 350;
    line-height: 1.5;
    cursor: pointer;
    transition: background-color 0.2s ease, opacity 0.2s ease;
    text-transform: uppercase;
  }

  .language-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }

  .language-button:focus-visible {
    outline: 2px solid var(--color-brand-500);
    outline-offset: 2px;
  }

  .language-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .language-switcher:hover .language-icon {
    transform: rotate(180deg);
  }

  .language-dropdown {
    position: absolute;
    top: calc(100% + var(--spacing-8));
    right: 0;
    min-width: 176px;
    max-height: 320px;
    opacity: 0;
    visibility: hidden;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-ui);
    border-radius: var(--spacing-radius-md);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    padding: var(--spacing-8) 0;
    z-index: 50;
    transition: opacity 0.2s ease, visibility 0.2s ease;
    overflow-y: auto;
  }

  .language-switcher:hover .language-dropdown,
  .language-switcher:focus-within .language-dropdown {
    opacity: 1;
    visibility: visible;
  }

  .language-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 10px var(--spacing-16);
    color: var(--text-primary);
    font-size: 14px;
    line-height: 1.5;
    text-decoration: none;
    transition: background-color 0.2s ease;
    text-align: left;
  }

  .language-option:hover {
    background-color: var(--color-neutral-100);
  }

  .language-option.active {
    background-color: rgba(14, 165, 233, 0.06); /* 6% opacity */
    color: var(--text-brand);
    font-weight: 500;
  }

  .language-check {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    color: var(--color-brand-500);
  }

  /* Scrollbar для dropdown */
  .language-dropdown::-webkit-scrollbar {
    width: 6px;
  }

  .language-dropdown::-webkit-scrollbar-track {
    background: transparent;
  }

  .language-dropdown::-webkit-scrollbar-thumb {
    background-color: var(--color-neutral-400);
    border-radius: 3px;
  }

  .language-dropdown::-webkit-scrollbar-thumb:hover {
    background-color: var(--color-neutral-500);
  }
</style>

<div class={`language-switcher ${className}`}>
  <button
    class="language-button"
    aria-label="Выбрать язык"
    aria-expanded="false"
    aria-haspopup="true"
  >
    <span>{currentLang.toUpperCase()}</span>
    <svg
      class="language-icon"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 9l-7 7-7-7"
      />
    </svg>
  </button>

  <div class="language-dropdown" role="menu">
    {Object.entries(languages).map(([code, name]) => (
      <a
        href={getLocalizedPath(currentPath, code as Lang)}
        class:list={['language-option', code === currentLang && 'active']}
        role="menuitem"
        data-astro-prefetch
        lang={code}
        dir={code === 'ar' ? 'rtl' : 'ltr'}
      >
        <span>{name}</span>
        {code === currentLang && (
          <svg class="language-check" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path
              fill-rule="evenodd"
              d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
              clip-rule="evenodd"
            />
          </svg>
        )}
      </a>
    ))}
  </div>
</div>

---
/**
 * Input Field Component
 * Использует дизайн-токены из tokens.ts
 * Touch Target: 48px (WCAG 2.1 AA)
 */

import { Tokens, Spacing } from '@/config/tokens';

interface Props {
  id: string;
  name: string;
  label?: string;
  type?: 'text' | 'email' | 'password' | 'tel' | 'url' | 'search' | 'number';
  placeholder?: string;
  required?: boolean;
  error?: string;
  value?: string;
  disabled?: boolean;
  autocomplete?: string;
  ariaDescribedBy?: string;
  class?: string;
}

const {
  id,
  name,
  label,
  type = 'text',
  placeholder,
  required = false,
  error,
  value,
  disabled = false,
  autocomplete,
  ariaDescribedBy,
  class: className = '',
} = Astro.props;

const errorId = error ? `${id}-error` : undefined;
const describedBy = [ariaDescribedBy, errorId].filter(Boolean).join(' ') || undefined;
---

<style>
  .input-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
  }

  .input-label {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .input-label-required {
    color: var(--border-error);
    margin-left: 4px;
  }

  .input-container {
    position: relative;
    width: 100%;
  }

  .input-field {
    width: 100%;
    min-height: 48px; /* Touch Target (WCAG 2.1 AA) */
    padding: 0 var(--spacing-16);
    border: 1px solid var(--border-ui);
    border-radius: var(--spacing-radius-md);
    background-color: var(--bg-surface);
    color: var(--text-primary);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .input-field::placeholder {
    color: var(--text-secondary);
    opacity: 1;
  }

  .input-field:hover:not(:disabled) {
    border-color: var(--color-neutral-400);
  }

  .input-field:focus {
    outline: none;
    border-color: var(--color-brand-500);
    box-shadow: 0 0 0 2px rgba(14, 165, 233, 0.2); /* 20% opacity */
  }

  .input-field:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    background-color: var(--color-neutral-100);
  }

  .input-field-error {
    border-color: var(--border-error);
  }

  .input-field-error:focus {
    border-color: var(--border-error);
    box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.2); /* 20% opacity */
  }

  .input-error {
    font-size: 14px;
    line-height: 1.4;
    color: var(--border-error);
    margin-top: var(--spacing-4);
  }
</style>

<div class={`input-wrapper ${className}`}>
  {label && (
    <label for={id} class="input-label">
      {label}
      {required && (
        <span class="input-label-required" aria-label="обязательное поле">
          *
        </span>
      )}
    </label>
  )}
  <div class="input-container">
    <input
      id={id}
      name={name}
      type={type}
      placeholder={placeholder}
      required={required}
      value={value}
      disabled={disabled}
      autocomplete={autocomplete}
      aria-describedby={describedBy}
      aria-invalid={error ? 'true' : undefined}
      aria-required={required}
      class={`input-field ${error ? 'input-field-error' : ''}`}
    />
  </div>
  {error && (
    <p id={errorId} class="input-error" role="alert" aria-live="polite">
      {error}
    </p>
  )}
</div>

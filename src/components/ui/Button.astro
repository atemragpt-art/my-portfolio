---
/**
 * Button Component
 * Использует дизайн-токены из tokens.ts
 * Touch Target: 48px (WCAG 2.1 AA)
 */

import { Tokens, Spacing } from '@/config/tokens';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  type?: 'button' | 'submit' | 'reset';
  size?: 'sm' | 'md' | 'lg';
  icon?: boolean;
  iconPosition?: 'left' | 'right';
  disabled?: boolean;
  ariaLabel?: string;
  class?: string;
}

const {
  href,
  variant = 'primary',
  type = 'button',
  size = 'md',
  icon = false,
  iconPosition = 'left',
  disabled = false,
  ariaLabel,
  class: className = '',
} = Astro.props;
---

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-8);
    border-radius: var(--spacing-radius-md);
    font-weight: 500;
    line-height: 1.5;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    cursor: pointer;
    border: none;
    text-decoration: none;
    white-space: nowrap;
  }

  /* Sizes */
  .button-sm {
    min-height: 32px;
    padding: var(--spacing-12) var(--spacing-16);
    font-size: 14px;
  }

  .button-md {
    min-height: 48px; /* Touch Target (WCAG 2.1 AA) */
    padding: 0 var(--spacing-32);
    font-size: 16px;
  }

  .button-lg {
    min-height: 56px;
    padding: 0 var(--spacing-48);
    font-size: 18px;
  }

  /* Variants */
  .button-primary {
    background-color: var(--bg-primary);
    color: var(--text-on-action);
  }

  .button-primary:hover:not(:disabled) {
    background-color: var(--bg-primary-hover);
  }

  .button-secondary {
    background-color: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border-ui);
  }

  .button-secondary:hover:not(:disabled) {
    background-color: var(--color-neutral-100);
    border-color: var(--color-neutral-400);
  }

  .button-outline {
    background-color: transparent;
    color: var(--text-brand);
    border: 1px solid var(--border-ui);
  }

  .button-outline:hover:not(:disabled) {
    background-color: var(--color-neutral-50);
    border-color: var(--text-brand);
  }

  .button:focus-visible {
    outline: 2px solid var(--color-brand-500);
    outline-offset: 2px;
  }

  .button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  .button-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .button-content {
    display: flex;
    align-items: center;
    gap: var(--spacing-8);
  }

  .button-content-reverse {
    flex-direction: row-reverse;
  }
</style>

{href ? (
  <a
    href={href}
    class:list={[
      'button',
      `button-${size}`,
      `button-${variant}`,
      className,
      disabled && 'button-disabled',
    ]}
    aria-label={ariaLabel}
    data-astro-prefetch
    style={disabled ? 'pointer-events: none; opacity: 0.5;' : ''}
  >
    <span class:list={['button-content', iconPosition === 'right' && 'button-content-reverse']}>
      {icon && iconPosition === 'left' && (
        <span class="button-icon" aria-hidden="true">
          <slot name="icon" />
        </span>
      )}
      <span>
        <slot />
      </span>
      {icon && iconPosition === 'right' && (
        <span class="button-icon" aria-hidden="true">
          <slot name="icon" />
        </span>
      )}
    </span>
  </a>
) : (
  <button
    type={type}
    class:list={[
      'button',
      `button-${size}`,
      `button-${variant}`,
      className,
      disabled && 'button-disabled',
    ]}
    disabled={disabled}
    aria-label={ariaLabel}
    aria-disabled={disabled}
  >
    <span class:list={['button-content', iconPosition === 'right' && 'button-content-reverse']}>
      {icon && iconPosition === 'left' && (
        <span class="button-icon" aria-hidden="true">
          <slot name="icon" />
        </span>
      )}
      <span>
        <slot />
      </span>
      {icon && iconPosition === 'right' && (
        <span class="button-icon" aria-hidden="true">
          <slot name="icon" />
        </span>
      )}
    </span>
  </button>
)}

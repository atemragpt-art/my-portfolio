---
interface Props {
  href?: string;
  featured?: boolean;
  featuredLabel?: string;
  class?: string;
}

const { href, featured = false, featuredLabel = 'Рекомендуемый', class: className = '' } = Astro.props;
---

<div class={`border border-gray-200 dark:border-gray-700 rounded-lg p-6 hover:shadow-lg transition-shadow ${className}`}>
  {featured && (
    <span class="inline-block px-3 py-1 bg-blue-600 text-white text-sm rounded-full mb-4">
      {featuredLabel}
    </span>
  )}
  <slot />
</div>

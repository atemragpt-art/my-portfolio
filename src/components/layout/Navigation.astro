---
interface Props {
  mobile?: boolean;
}

const { mobile = false } = Astro.props;

const navItems = [
  { href: '/', label: 'Главная' },
  { href: '/about/', label: 'О компании' },
  {
    href: '/solutions/',
    label: 'Услуги',
    children: [
      { href: '/solutions/nc-programming', label: 'NC Programming' },
      { href: '/solutions/postprocessors', label: 'Postprocessors' },
      { href: '/solutions/vericut-simulation', label: 'VERICUT Simulation' },
    ],
  },
  {
    href: '/expertise/',
    label: 'Экспертиза',
    children: [
      { href: '/expertise/nx-cad', label: 'NX CAD' },
      { href: '/expertise/nx-cam', label: 'NX CAM' },
      { href: '/expertise/vericut', label: 'VERICUT' },
    ],
  },
  {
    href: '/industries/',
    label: 'Отрасли',
    children: [
      { href: '/industries/aerospace', label: 'Аэрокосмическая' },
      { href: '/industries/energy-oil-gas', label: 'Энергетика и нефтегаз' },
      { href: '/industries/machinery', label: 'Машиностроение' },
    ],
  },
  { href: '/cases/', label: 'Кейсы' },
  { href: '/blog/', label: 'Блог' },
  { href: '/contact/', label: 'Контакты' },
];

const currentPath = Astro.url.pathname;
---

{mobile ? (
  <ul class="space-y-2 mt-4">
    {navItems.map((item) => (
      <li>
        <a
          href={item.href}
          class={`block px-4 py-2 rounded-lg transition-colors ${
            currentPath === item.href
              ? 'bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300'
              : 'text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800'
          }`}
          data-astro-prefetch
        >
          {item.label}
        </a>
        {item.children && (
          <ul class="ml-4 mt-2 space-y-1">
            {item.children.map((child) => (
              <li>
                <a
                  href={child.href}
                  class={`block px-4 py-2 rounded-lg text-sm transition-colors ${
                    currentPath === child.href
                      ? 'bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-400'
                      : 'text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800'
                  }`}
                  data-astro-prefetch
                >
                  {child.label}
                </a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
) : (
  <ul class="flex items-center space-x-6">
    {navItems.map((item) => (
      <li class="relative group">
        <a
          href={item.href}
          class={`px-3 py-2 rounded-lg transition-colors ${
            currentPath === item.href
              ? 'text-blue-600 dark:text-blue-400 font-semibold'
              : 'text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400'
          }`}
          data-astro-prefetch
        >
          {item.label}
        </a>
        {item.children && (
          <div class="absolute left-0 mt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 bg-white dark:bg-gray-800 rounded-lg shadow-lg border border-gray-200 dark:border-gray-700 p-2">
            <ul class="space-y-1">
              {item.children.map((child) => (
                <li>
                  <a
                    href={child.href}
                    class={`block px-3 py-2 rounded-lg text-sm transition-colors ${
                      currentPath === child.href
                        ? 'bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300'
                        : 'text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700'
                    }`}
                    data-astro-prefetch
                  >
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </li>
    ))}
  </ul>
)}

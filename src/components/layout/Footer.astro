---
import { useTranslations, getLocalizedPath, type Lang } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

// Локализованные ссылки
const footerLinks = {
  company: [
    { href: getLocalizedPath('/about/', lang), label: t('nav.about') },
    { href: getLocalizedPath('/hr/', lang), label: t('footer.career') },
  ],
  resources: [
    { href: getLocalizedPath('/blog/', lang), label: t('nav.blog') },
    { href: getLocalizedPath('/cases/', lang), label: t('nav.cases') },
    { href: getLocalizedPath('/faq/', lang), label: t('nav.faq') },
  ],
  legal: [
    { href: getLocalizedPath('/privacy/', lang), label: t('footer.privacy') },
    { href: getLocalizedPath('/terms/', lang), label: t('footer.terms') },
  ],
  contact: [
    { href: getLocalizedPath('/contact/', lang), label: t('nav.contact') },
  ],
};
---

<footer class="bg-gray-50 dark:bg-gray-900 border-t border-gray-200 dark:border-gray-800">
  <div class="container mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-8">
      {/* Компания */}
      <div>
        <h3 class="text-lg font-semibold mb-4 text-gray-900 dark:text-white">
          {t('footer.company')}
        </h3>
        <ul class="space-y-2">
          {footerLinks.company.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                data-astro-prefetch
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Ресурсы */}
      <div>
        <h3 class="text-lg font-semibold mb-4 text-gray-900 dark:text-white">
          {t('footer.resources')}
        </h3>
        <ul class="space-y-2">
          {footerLinks.resources.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                data-astro-prefetch
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Правовая информация */}
      <div>
        <h3 class="text-lg font-semibold mb-4 text-gray-900 dark:text-white">
          {t('footer.legal')}
        </h3>
        <ul class="space-y-2">
          {footerLinks.legal.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                data-astro-prefetch
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Контакты */}
      <div>
        <h3 class="text-lg font-semibold mb-4 text-gray-900 dark:text-white">
          {t('footer.contacts')}
        </h3>
        <ul class="space-y-2">
          {footerLinks.contact.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                data-astro-prefetch
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {/* Copyright */}
    <div class="pt-8 border-t border-gray-200 dark:border-gray-800 text-center text-gray-600 dark:text-gray-400">
      <p>{t('footer.copyright', { year: currentYear })}</p>
    </div>
  </div>
</footer>

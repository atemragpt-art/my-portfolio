---
/**
 * Footer Component
 * Подвал сайта согласно дизайн-системе
 * Использует дизайн-токены и компоненты из дизайн-системы
 */

import { useTranslations, getLocalizedPath, type Lang } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

// Локализованные ссылки
const footerLinks = {
  company: [
    { href: getLocalizedPath('/about/', lang), label: t('nav.about') },
    { href: getLocalizedPath('/hr/', lang), label: t('footer.career') },
  ],
  resources: [
    { href: getLocalizedPath('/blog/', lang), label: t('nav.blog') },
    { href: getLocalizedPath('/cases/', lang), label: t('nav.cases') },
    { href: getLocalizedPath('/faq/', lang), label: t('nav.faq') },
  ],
  legal: [
    { href: getLocalizedPath('/privacy/', lang), label: t('footer.privacy') },
    { href: getLocalizedPath('/terms/', lang), label: t('footer.terms') },
  ],
  contact: [
    { href: getLocalizedPath('/contact/', lang), label: t('nav.contact') },
  ],
};
---

<style>
  .footer {
    width: 100%;
    background-color: var(--bg-surface);
    border-top: 1px solid var(--border-ui);
    padding: var(--spacing-64) var(--spacing-64);
  }

  .footer-container {
    max-width: 1312px;
    margin: 0 auto;
    width: 100%;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-32);
    margin-bottom: var(--spacing-48);
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-16);
  }

  .footer-column-title {
    font-size: 16px;
    font-weight: 600; /* SemiBold */
    line-height: 1.5;
    color: var(--text-primary);
    margin: 0;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-12);
  }

  .footer-link {
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: var(--text-brand);
  }

  .footer-copyright {
    padding-top: var(--spacing-32);
    border-top: 1px solid var(--border-ui);
    text-align: center;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.4;
    color: var(--text-secondary);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .footer {
      padding: var(--spacing-48) var(--spacing-32);
    }

    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-24);
    }
  }

  @media (max-width: 768px) {
    .footer {
      padding: var(--spacing-48) var(--spacing-16);
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-24);
    }
  }
</style>

<footer class="footer" role="contentinfo" aria-label="Footer">
  <div class="footer-container">
    <div class="footer-grid">
      {/* Компания */}
      <div class="footer-column">
        <h3 class="footer-column-title">{t('footer.company')}</h3>
        <ul class="footer-links">
          {footerLinks.company.map((link) => (
            <li>
              <a href={link.href} class="footer-link" data-astro-prefetch>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Ресурсы */}
      <div class="footer-column">
        <h3 class="footer-column-title">{t('footer.resources')}</h3>
        <ul class="footer-links">
          {footerLinks.resources.map((link) => (
            <li>
              <a href={link.href} class="footer-link" data-astro-prefetch>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Правовая информация */}
      <div class="footer-column">
        <h3 class="footer-column-title">{t('footer.legal')}</h3>
        <ul class="footer-links">
          {footerLinks.legal.map((link) => (
            <li>
              <a href={link.href} class="footer-link" data-astro-prefetch>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Контакты */}
      <div class="footer-column">
        <h3 class="footer-column-title">{t('footer.contacts')}</h3>
        <ul class="footer-links">
          {footerLinks.contact.map((link) => (
            <li>
              <a href={link.href} class="footer-link" data-astro-prefetch>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {/* Copyright */}
    <div class="footer-copyright">
      <p>{t('footer.copyright', { year: currentYear })}</p>
    </div>
  </div>
</footer>

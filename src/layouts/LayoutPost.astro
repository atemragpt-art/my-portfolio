---
import LayoutMain from '@/layouts/LayoutMain.astro';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
}

const { title, description, ogType = 'article' } = Astro.props;
---

<LayoutMain title={title} description={description} ogType={ogType}>
  <slot />
</LayoutMain>

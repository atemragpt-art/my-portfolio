---
import { ClientRouter } from 'astro:transitions';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { getLangFromUrl, getAlternateLinks, getLocalizedPath, getDirection, defaultLang } from '@/i18n/utils';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  canonical?: string;
  noindex?: boolean;
}

const { 
  title, 
  description = '', 
  ogImage,
  ogType = 'website',
  canonical,
  noindex = false,
} = Astro.props;

// Определяем язык из URL
const lang = getLangFromUrl(Astro.url);
const dir = getDirection(lang);
const isRtl = dir === 'rtl';

// Формируем URLs
// Используем Astro.site если настроен, иначе fallback на текущий origin (для dev)
const siteUrl = Astro.site?.href?.replace(/\/$/, '') || Astro.url.origin;
const canonicalPath = canonical ?? Astro.url.pathname;
const fullUrl = `${siteUrl}${canonicalPath}`;
const ogImageUrl = ogImage ? `${siteUrl}${ogImage}` : `${siteUrl}/og-image.jpg`;

// Альтернативные языковые версии для SEO
const alternateLinks = getAlternateLinks(Astro.url.pathname, siteUrl);

// Предупреждение если site не настроен (только для production)
// Используем import.meta.env.PROD вместо MODE для надежной работы с кастомными build modes
if (!Astro.site?.href && import.meta.env.PROD) {
  console.warn('⚠️  Astro.site не настроен в astro.config.mjs. Укажи site URL перед деплоем.');
}
---

<!doctype html>
<html lang={lang} dir={dir} class:list={[{ rtl: isRtl }]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    
    {/* hreflang для всех языковых версий — критично для SEO */}
    {alternateLinks.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}
    {/* x-default указывает на текущую страницу на дефолтном языке (ru) */}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${getLocalizedPath(Astro.url.pathname, defaultLang)}`} />
    
    {/* Open Graph */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:locale" content={lang} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    
    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    
    <link rel="canonical" href={fullUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    {/* Preconnect для Google Fonts (CJK шрифты) */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    {/* Preload критичных шрифтов (если будут локальные шрифты) */}
    {/* 
    <link 
      rel="preload" 
      href="/fonts/critical-font.woff2" 
      as="font" 
      type="font/woff2" 
      crossorigin 
    />
    */}
    
    {/* Noto Sans для CJK и арабского */}
    {/* display=swap уже включен в URL - предотвращает FOIT/FOUT */}
    <link 
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&family=Noto+Sans+Arabic:wght@400;500;700&display=swap" 
      rel="stylesheet"
    />
    
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100">
    <Header lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

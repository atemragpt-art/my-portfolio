---
import LayoutService from '@/layouts/LayoutService.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';

const solutions = [
  { slug: 'nc-programming', title: 'NC Programming', description: 'Программирование ЧПУ' },
  { slug: 'postprocessors', title: 'Postprocessors', description: 'Постпроцессоры' },
  { slug: 'vericut-simulation', title: 'VERICUT Simulation', description: 'Симуляция VERICUT' },
];
---

<LayoutService title="Решения" description="Наши решения и услуги">
  <Section>
    <h1 class="text-4xl font-bold mb-8">Решения</h1>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {solutions.map((solution) => (
        <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-6 hover:shadow-lg transition-shadow">
          <h2 class="text-2xl font-semibold mb-2">{solution.title}</h2>
          <p class="text-gray-600 dark:text-gray-400 mb-4">{solution.description}</p>
          <Button href={`/solutions/${solution.slug}`}>Подробнее</Button>
        </div>
      ))}
    </div>
  </Section>
</LayoutService>

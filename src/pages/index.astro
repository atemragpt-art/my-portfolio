---
import LayoutMain from '@/layouts/LayoutMain.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import CooperationModels from '@/components/sections/CooperationModels.astro';
import { generateOrganizationSchema } from '@/utils/schema';
import { SITE_CONFIG } from '@/config/site';

interface Props {}

const organizationSchema = generateOrganizationSchema({
  name: SITE_CONFIG.name,
  description: SITE_CONFIG.description,
  url: Astro.site?.href || Astro.url.origin,
  contactPoint: {
    contactType: 'Customer Service',
  },
});
---

<LayoutMain title="Главная" description="Главная страница портфолио">
  <script type="application/ld+json" set:html={organizationSchema} />
  <Section>
    <h1 class="text-4xl font-bold mb-4">Добро пожаловать</h1>
    <p class="text-lg text-gray-600 dark:text-gray-400 mb-6">
      Это главная страница сайта. Здесь будет размещен контент согласно Шаблону 1.
    </p>
    <Button href="/about">О компании</Button>
  </Section>

  <CooperationModels />
</LayoutMain>

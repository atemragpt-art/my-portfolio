---
import LayoutMain from '@/layouts/LayoutMain.astro';
import Hero from '@/components/sections/Hero.astro';
import CasesGrid from '@/components/sections/CasesGrid.astro';
import CooperationModels from '@/components/sections/CooperationModels.astro';
import { generateOrganizationSchema } from '@/utils/schema';
import { SITE_CONFIG } from '@/config/site';
import { getLangFromUrl } from '@/i18n/utils';

interface Props {}

const lang = getLangFromUrl(Astro.url);

const organizationSchema = generateOrganizationSchema({
  name: SITE_CONFIG.name,
  description: SITE_CONFIG.description,
  url: Astro.site?.href || Astro.url.origin,
  contactPoint: {
    contactType: 'Customer Service',
  },
});

// Фоновое видео Hero section
// ВАЖНО: Все медиа-файлы должны находиться в src/assets/images/
// Видео предпочтительнее GIF: меньше размер, лучше качество, поддержка autoplay/loop
// В Astro видео из src/assets/ можно импортировать напрямую
import heroBackgroundVideo from '@/assets/images/hero/video.mp4';
import heroBackgroundImage from '@/assets/images/hero/hero-bg.jpg'; // Fallback
---

<LayoutMain title="Главная" description="Главная страница портфолио">
  <script type="application/ld+json" set:html={organizationSchema} />
  
  <Hero 
    lang={lang}
    backgroundVideo={heroBackgroundVideo}
    backgroundImage={heroBackgroundImage}
    title="ЭКСПЕРТНАЯ ПОДДЕРЖКА В МЕТАЛЛООБРАБОТКЕ"
    description="Получите профессиональное внедрение инструмента и защиту интересов перед заказчиком, привлекая эксперта именно тогда, когда это нужно вашему бизнесу."
    ctaText="Начать проект"
  />

  <CasesGrid lang={lang} limit={3} />

  <CooperationModels />
</LayoutMain>

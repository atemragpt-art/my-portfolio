---
import { getCollection } from 'astro:content';
import LayoutService from '@/layouts/LayoutService.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import { useTranslations, getLocalizedPath, type Lang } from '@/i18n/utils';
import { filterByLang, getIdSlug } from '@/utils/content';

const lang: Lang = 'en';
const t = useTranslations(lang);

// Фильтруем отрасли по языку
const allIndustries = await getCollection('industries');
const industries = filterByLang(allIndustries, lang);
---

<LayoutService 
  title={t('nav.industries')} 
  description="Industries we work with"
>
  <Section>
    <h1 class="text-4xl font-bold mb-8">{t('nav.industries')}</h1>
    
    {industries.length === 0 ? (
      <EmptyState message={t('common.empty')} />
    ) : (
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {industries.map((industry) => (
          <Card>
            <h2 class="text-2xl font-semibold mb-2">{industry.data.title}</h2>
            <p class="text-gray-600 dark:text-gray-400 mb-4">{industry.data.description}</p>
            {industry.data.services.length > 0 && (
              <div class="mb-4 flex flex-wrap gap-2">
                {industry.data.services.map((service) => (
                  <Badge size="sm">{service}</Badge>
                ))}
              </div>
            )}
            <Button href={getLocalizedPath(`/industries/${getIdSlug(industry.id)}`, lang)}>{t('common.readMore')}</Button>
          </Card>
        ))}
      </div>
    )}
  </Section>
</LayoutService>

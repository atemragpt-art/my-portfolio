---
import LayoutLegal from '@/layouts/LayoutLegal.astro';
import { useTranslations } from '@/i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);
---

<LayoutLegal 
  title={t('footer.terms')} 
  description="Terms of Service"
>
  <h1 class="text-4xl font-bold mb-6">{t('footer.terms')}</h1>
  <div class="prose dark:prose-invert">
    <p>Terms of service content according to Template 10.</p>
  </div>
</LayoutLegal>

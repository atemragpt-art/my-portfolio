---
import LayoutService from '@/layouts/LayoutService.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';

const industries = [
  { slug: 'aerospace', title: 'Аэрокосмическая отрасль', description: 'Решения для аэрокосмической отрасли' },
  { slug: 'energy-oil-gas', title: 'Энергетика и нефтегаз', description: 'Решения для энергетики и нефтегаза' },
  { slug: 'machinery', title: 'Машиностроение', description: 'Решения для машиностроения' },
];
---

<LayoutService title="Отрасли" description="Отрасли, в которых мы работаем">
  <Section>
    <h1 class="text-4xl font-bold mb-8">Отрасли</h1>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {industries.map((industry) => (
        <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-6 hover:shadow-lg transition-shadow">
          <h2 class="text-2xl font-semibold mb-2">{industry.title}</h2>
          <p class="text-gray-600 dark:text-gray-400 mb-4">{industry.description}</p>
          <Button href={`/industries/${industry.slug}`}>Подробнее</Button>
        </div>
      ))}
    </div>
  </Section>
</LayoutService>

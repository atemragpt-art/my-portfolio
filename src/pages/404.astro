---
import LayoutMain from '@/layouts/LayoutMain.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
---

<LayoutMain title="404 - Страница не найдена" description="Страница не найдена">
  <Section>
    <div class="text-center">
      <h1 class="text-6xl font-bold mb-4">404</h1>
      <h2 class="text-3xl font-semibold mb-4">Страница не найдена</h2>
      <p class="text-gray-600 dark:text-gray-400 mb-8">
        К сожалению, запрашиваемая страница не существует.
      </p>
      <Button href="/">Вернуться на главную</Button>
    </div>
  </Section>
</LayoutMain>

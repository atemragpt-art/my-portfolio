---
import { getCollection } from 'astro:content';
import LayoutMain from '@/layouts/LayoutMain.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import { sortByDate } from '@/utils/sorting';
import { filterByLang } from '@/utils/content';

const lang = 'ru' as const;
const allBlogPosts = await getCollection('blog', ({ data }) => !data.draft);
const blogPosts = filterByLang(allBlogPosts, lang);
const sortedPosts = sortByDate(blogPosts);
---

<LayoutMain title="Блог" description="Статьи и новости">
  <Section>
    <h1 class="text-4xl font-bold mb-8">Блог</h1>
    
    {sortedPosts.length === 0 ? (
      <EmptyState message="Пока нет опубликованных статей." />
    ) : (
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {sortedPosts.map((post) => (
          <Card>
            <h2 class="text-2xl font-semibold mb-2">
              <a href={`/blog/${post.slug}`} class="hover:text-blue-600 dark:hover:text-blue-400" data-astro-prefetch>
                {post.data.title}
              </a>
            </h2>
            <p class="text-gray-600 dark:text-gray-400 mb-4">{post.data.description}</p>
            <time class="text-sm text-gray-500 dark:text-gray-500">
              {post.data.pubDate.toLocaleDateString('ru-RU')}
            </time>
            {post.data.tags.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <Badge>{tag}</Badge>
                ))}
              </div>
            )}
          </Card>
        ))}
      </div>
    )}
  </Section>
</LayoutMain>

---
import { getCollection } from 'astro:content';
import LayoutMain from '@/layouts/LayoutMain.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';

const cases = await getCollection('cases');
const sortedCases = cases.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return 0;
});
---

<LayoutMain title="Кейсы" description="Наши проекты и кейсы">
  <Section>
    <h1 class="text-4xl font-bold mb-8">Кейсы</h1>
    
    {sortedCases.length === 0 ? (
      <p class="text-gray-600 dark:text-gray-400">Пока нет опубликованных кейсов.</p>
    ) : (
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {sortedCases.map((caseItem) => (
          <article class="border border-gray-200 dark:border-gray-700 rounded-lg p-6 hover:shadow-lg transition-shadow">
            {caseItem.data.featured && (
              <span class="inline-block px-3 py-1 bg-blue-600 text-white text-sm rounded-full mb-4">
                Рекомендуемый
              </span>
            )}
            <h2 class="text-2xl font-semibold mb-2">
              <a href={`/cases/${caseItem.slug}`} class="hover:text-blue-600 dark:hover:text-blue-400" data-astro-prefetch>
                {caseItem.data.title}
              </a>
            </h2>
            <p class="text-gray-600 dark:text-gray-400 mb-4">{caseItem.data.description}</p>
            {caseItem.data.client && (
              <p class="text-sm text-gray-500 dark:text-gray-500 mb-2">
                Клиент: {caseItem.data.client}
              </p>
            )}
            {caseItem.data.industry && (
              <p class="text-sm text-gray-500 dark:text-gray-500 mb-4">
                Отрасль: {caseItem.data.industry}
              </p>
            )}
            {caseItem.data.technologies.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-2">
                {caseItem.data.technologies.map((tech) => (
                  <span class="px-2 py-1 bg-gray-100 dark:bg-gray-800 text-sm rounded">
                    {tech}
                  </span>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
    )}
  </Section>
</LayoutMain>

---
import { getCollection } from 'astro:content';
import LayoutPost from '@/layouts/LayoutPost.astro';
import Section from '@/components/ui/Section.astro';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((caseItem) => ({
    params: { slug: caseItem.slug },
    props: { caseItem },
  }));
}

interface Props {
  caseItem: Awaited<ReturnType<typeof getCollection>>[number];
}

const { caseItem } = Astro.props;
const { Content } = await caseItem.render();
---

<LayoutPost
  title={caseItem.data.title}
  description={caseItem.data.description}
>
  <Section>
    <article class="prose dark:prose-invert max-w-4xl mx-auto">
      <h1 class="text-4xl font-bold mb-4">{caseItem.data.title}</h1>
      <p class="text-xl text-gray-600 dark:text-gray-400 mb-6">{caseItem.data.description}</p>
      
      {(caseItem.data.client || caseItem.data.industry) && (
        <div class="mb-6 p-4 bg-gray-100 dark:bg-gray-800 rounded-lg">
          {caseItem.data.client && (
            <p class="mb-2"><strong>Клиент:</strong> {caseItem.data.client}</p>
          )}
          {caseItem.data.industry && (
            <p><strong>Отрасль:</strong> {caseItem.data.industry}</p>
          )}
        </div>
      )}
      
      <Content />
      
      {caseItem.data.technologies.length > 0 && (
        <div class="mt-8">
          <h3 class="text-xl font-semibold mb-4">Технологии</h3>
          <div class="flex flex-wrap gap-2">
            {caseItem.data.technologies.map((tech) => (
              <span class="px-3 py-1 bg-gray-100 dark:bg-gray-800 rounded-full text-sm">
                {tech}
              </span>
            ))}
          </div>
        </div>
      )}
    </article>
  </Section>
</LayoutPost>

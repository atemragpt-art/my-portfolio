---
import { getCollection } from 'astro:content';
import LayoutService from '@/layouts/LayoutService.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import { sortByFeatured } from '@/utils/sorting';
import { filterByLang, getIdSlug } from '@/utils/content';
import type { Lang } from '@/i18n/utils';

const lang: Lang = 'ru';
const allExpertiseItems = await getCollection('expertise');
const expertiseItems = filterByLang(allExpertiseItems, lang);
const sortedExpertise = sortByFeatured(expertiseItems);
---

<LayoutService title="Экспертиза" description="Наша экспертиза и технологии">
  <Section>
    <h1 class="text-4xl font-bold mb-8">Экспертиза</h1>
    
    {sortedExpertise.length === 0 ? (
      <EmptyState message="Пока нет опубликованных направлений экспертизы." />
    ) : (
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {sortedExpertise.map((item) => (
          <Card featured={item.data.featured} featuredLabel="Рекомендуемое">
            <h2 class="text-2xl font-semibold mb-2">{item.data.title}</h2>
            <p class="text-gray-600 dark:text-gray-400 mb-4">{item.data.description}</p>
            {item.data.technologies.length > 0 && (
              <div class="mb-4 flex flex-wrap gap-2">
                {item.data.technologies.map((tech) => (
                  <Badge>{tech}</Badge>
                ))}
              </div>
            )}
            <Button href={`/expertise/${getIdSlug(item.id)}`}>Подробнее</Button>
          </Card>
        ))}
      </div>
    )}
  </Section>
</LayoutService>

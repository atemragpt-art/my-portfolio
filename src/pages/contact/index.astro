---
import LayoutMain from '@/layouts/LayoutMain.astro';
import Section from '@/components/ui/Section.astro';
import Input from '@/components/ui/Input.astro';
import Button from '@/components/ui/Button.astro';
---

<LayoutMain title="Контакты" description="Свяжитесь с нами">
  <Section>
    <h1 class="text-4xl font-bold mb-6">Свяжитесь с нами</h1>
    
    <form class="max-w-2xl" id="contact-form">
      <Input
        id="name"
        name="name"
        label="Имя"
        required
      />
      
      <Input
        id="contact"
        name="contact"
        label="Email или телефон"
        type="text"
        placeholder="email@example.com или +7 (999) 123-45-67"
        required
      />
      
      <div class="mb-4">
        <label for="message" class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">
          Сообщение <span class="text-red-500 ml-1">*</span>
        </label>
        <textarea
          id="message"
          name="message"
          required
          rows="6"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white"
          placeholder="Ваше сообщение..."
        ></textarea>
      </div>
      
      <div id="form-message" class="mb-4 hidden"></div>
      
      <Button type="submit">Отправить</Button>
    </form>
  </Section>
</LayoutMain>

<script>
  // Инициализация формы при загрузке и после View Transitions
  async function setupContactForm() {
    const { actions, isInputError } = await import('astro:actions');
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const messageDiv = document.getElementById('form-message') as HTMLDivElement;

    if (!form || !messageDiv) return;

    // Удаляем старые обработчики, если есть
    const newForm = form.cloneNode(true) as HTMLFormElement;
    form.parentNode?.replaceChild(newForm, form);

    newForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(newForm);
      messageDiv.classList.add('hidden');
      
      try {
        const input = {
          name: formData.get('name')?.toString() || '',
          contact: formData.get('contact')?.toString() || '',
          message: formData.get('message')?.toString() || '',
        };

        const { data, error } = await actions.submitContactForm(input);
        
        if (error) {
          // Проверяем, это ошибка валидации?
          if (isInputError(error)) {
            // Показываем ошибки валидации
            const errorMessages = Object.values(error.fields)
              .flat()
              .map((err) => err.message)
              .join(', ');
            messageDiv.className = 'mb-4 p-4 bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 rounded-lg';
            messageDiv.textContent = `Ошибка валидации: ${errorMessages}`;
            messageDiv.classList.remove('hidden');
          } else {
            // Другие ошибки
            messageDiv.className = 'mb-4 p-4 bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 rounded-lg';
            messageDiv.textContent = error.message || 'Произошла ошибка при отправке формы';
            messageDiv.classList.remove('hidden');
          }
        } else if (data?.success) {
          messageDiv.className = 'mb-4 p-4 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 rounded-lg';
          messageDiv.textContent = data.message || 'Сообщение успешно отправлено';
          messageDiv.classList.remove('hidden');
          newForm.reset();
          
          // Перенаправление на страницу успеха через 2 секунды
          setTimeout(() => {
            window.location.href = '/form-success';
          }, 2000);
        }
      } catch (error) {
        messageDiv.className = 'mb-4 p-4 bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 rounded-lg';
        messageDiv.textContent = 'Произошла ошибка при отправке формы. Попробуйте позже.';
        messageDiv.classList.remove('hidden');
      }
    });
  }

  // Запускаем при загрузке и после View Transitions
  setupContactForm();
  window.addEventListener('astro:page-load', setupContactForm);
</script>

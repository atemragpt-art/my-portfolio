---
import LayoutService from '@/layouts/LayoutService.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';

const engagement = [
  { slug: 'fractional-lead-technologist', title: 'Fractional Lead Technologist', description: 'Фрактальный ведущий технолог' },
  { slug: 'pricing', title: 'Ценообразование', description: 'Информация о ценах и тарифах' },
];
---

<LayoutService title="Взаимодействие" description="Формы взаимодействия и ценообразование">
  <Section>
    <h1 class="text-4xl font-bold mb-8">Взаимодействие</h1>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {engagement.map((item) => (
        <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-6 hover:shadow-lg transition-shadow">
          <h2 class="text-2xl font-semibold mb-2">{item.title}</h2>
          <p class="text-gray-600 dark:text-gray-400 mb-4">{item.description}</p>
          <Button href={`/engagement/${item.slug}`}>Подробнее</Button>
        </div>
      ))}
    </div>
  </Section>
</LayoutService>
